NODE_ENV=development

# MySQL 8 connection string (Drizzle)
DATABASE_URL=mysql://user:password@localhost:3306/vendercrm

# 32-byte hex key for AES-256-GCM (lib/crypto). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

APP_URL=http://localhost:3000

# Better Auth session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# local (bootstrap) or s3 (Cloudflare R2 or similar — see PLAN.md §2.1)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage

# Shared secret for the Hostinger-pinged cron fallback route (api/cron)
CRON_SECRET=

# WhatsApp / Meta Cloud API (optional in dev; required to receive/send)
# App secret — used to verify the X-Hub-Signature-256 on inbound webhooks.
META_APP_SECRET=
# Token you set in the Meta webhook config; echoed back on GET verification.
META_WEBHOOK_VERIFY_TOKEN=
# Graph API version.
META_GRAPH_VERSION=v21.0
