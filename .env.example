NODE_ENV=development

# MySQL 8 connection string (Drizzle)
DATABASE_URL=mysql://user:password@localhost:3306/vendercrm

# 32-byte hex key for AES-256-GCM (lib/crypto). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

APP_URL=http://localhost:3000

# local (bootstrap) or s3 (Cloudflare R2 or similar — see PLAN.md §2.1)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage

# Shared secret for the Hostinger-pinged cron fallback route (api/cron)
CRON_SECRET=

# How many reverse proxies sit in front of the app. Decides which
# x-forwarded-for entry the rate limiters trust, counting from the right.
# 1 = Hostinger's LiteSpeed alone (the deployed shape); 2 = a CDN in front of
# it. Verify against a live deploy per docs/DEPLOY.md §10.
TRUSTED_PROXY_HOPS=1

# Hostnames this deployment answers on. Optional — they default to the
# production values. middleware.ts routes the marketing site and the CRM app
# apart on these, so only set them for a staging domain or a rename.
# APEX_HOST=clientes.com.py
# APP_HOST=crm.clientes.com.py

# Where the rate-limit windows are counted: mysql (default outside tests) or
# memory. Leave unset in production — `memory` counts per process and forgets
# every window on deploy, which is exactly what §14 I1 replaced.
# RATE_LIMIT_DRIVER=mysql

# Better Auth session/cookie signing secret (>=32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Meta WhatsApp Cloud API — one Meta developer app for the whole platform
# (PLAN.md §6.1). WHATSAPP_APP_SECRET signs incoming webhook payloads
# (X-Hub-Signature-256); WHATSAPP_WEBHOOK_VERIFY_TOKEN is the arbitrary
# string you set in the Meta app's webhook config for the GET verify
# handshake. Per-tenant phone numbers/tokens are stored encrypted in
# wa_accounts, not here.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Meta Graph API version. Optional — defaults to the version the app was
# built against. Meta retires versions on a schedule, and the superadmin
# WhatsApp health page warns once the configured one is past its documented
# review date (modules/whatsapp/graph.ts).
# WHATSAPP_GRAPH_API_VERSION=v21.0

# AI auto-reply. Opt-in: `none` (the default) means the ai_reply automation
# node skips with a reason instead of generating, and the app boots normally
# without any key. Set AI_DRIVER to openai or gemini and supply that
# provider's key — only the selected driver's key is required.
#   AI_MODEL     overrides the driver default (gpt-4o-mini / gemini-2.0-flash)
#   AI_BASE_URL  overrides the API base — for Azure OpenAI, an OpenAI-compatible
#                gateway, or pointing staging at a stub instead of a billable
#                endpoint
#   AI_TRANSCRIBE_MODEL  overrides the audio model used for WhatsApp voice
#                notes (gpt-4o-mini-transcribe / gemini-2.0-flash). Voice
#                notes are transcribed by whichever driver is selected above;
#                with AI_DRIVER=none nothing is transcribed and the inbox
#                simply shows the audio as before.
# Per-tenant behavior (business context, draft vs. autonomous send, daily
# caps, handoff keyword) is configured in the app under Configuración, not
# here — this only chooses the provider.
AI_DRIVER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TRANSCRIBE_MODEL=

# Sentry error tracking (PLAN.md §10 1H #4) — all optional. Unset = disabled,
# no-op (see src/instrumentation-client.ts, src/sentry.*.config.ts). DSN is
# public-safe by design (client bundle exposes it either way), which is why
# it's NEXT_PUBLIC_; SERVER_DSN is separate mainly by Sentry convention, the
# same DSN value works for both.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Only needed to upload source maps at build time — omit to skip that step.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# clientes.com.py marketing site — its own contact form posts server-to-server
# to this app's public /api/v1/leads, exactly as any customer site does
# (MARKETING_SITE_PLAN.md §1.2). The key is the site API key created under
# Sitios for the clientes.com.py site row on the owner's tenant.
#
# Deliberately NOT prefixed NEXT_PUBLIC_: that would inline the key into the
# client bundle and let anyone write into the pipeline. Unset means the form
# still thanks the visitor and logs the failure — but no lead is recorded.
VENDERCRM_API_KEY=
# Optional override; defaults to https://crm.clientes.com.py.
VENDERCRM_URL=

# Google Calendar busy-read (plan-booking.md §5.4). One Google Cloud project
# for the whole platform; each staff member connects their own calendar. The
# authorized redirect URI must be
#   https://crm.<your-domain>/api/gcal/callback
# (http://localhost:3000/api/gcal/callback in development).
# While these are unset the feature no-ops: the connect button says so and
# slot generation simply has no Google busy windows to merge.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web push on the installed PWA (PLAN.md §15.5 J2). One VAPID keypair for the
# whole platform — generate it once with `npm run generate-vapid` and paste
# both halves here. While these are unset the feature is hidden: no "activar
# notificaciones" control renders, /api/push/subscribe answers 404, and
# `push.send` jobs no-op. Nothing is lost when it is off — every push is a
# second copy of a `notifications` row the bell already shows.
#
# The public key reaches the browser by design (it is what a subscription is
# signed against), so it is not a secret; it is still read server-side and
# passed down as a prop, so the two halves of the keypair can never drift.
# Changing the keypair invalidates every existing subscription: browsers
# re-subscribe on their next visit, and the old rows fall away on the first
# 410 (see modules/notifications/subscriptions.ts).
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Where a push service should complain if this app misbehaves. mailto: or https://.
WEB_PUSH_SUBJECT=mailto:soporte@clientes.com.py

# Default-tier sending subdomain (PLAN.md §15.1, §15.8 P4) — a dedicated
# subdomain, not the apex, so the platform's transactional mail never shares
# reputation with a tenant's own verified domain or the marketing site.
# Unset means senderFor(ctx) falls back to RESEND_FROM_EMAIL exactly as
# before this phase.
EMAIL_DEFAULT_DOMAIN=mail.clientes.com.py
